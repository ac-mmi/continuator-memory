  "experimental_findings": [
    {
      "id": 1,
      "finding": "SciFact hybrid retrieval",
      "proves": "BM25 and dense are complementary for single-evidence candidates",
      "implication": "Keep hybrid candidate generation in EU experiments",
      "justifies_architecture_change": true,
      "scope": "experiment"
    },
    {
      "id": 2,
      "finding": "SciFact CE reranking",
      "proves": "Independent CE improves single-evidence ranking on fixed pools",
      "implication": "CE is necessary but not sufficient for multi-evidence set coverage",
      "justifies_architecture_change": true,
      "scope": "experiment"
    },
    {
      "id": 3,
      "finding": "SciFact terminology mismatch",
      "proves": "Some misses are vocab/label issues, not ranker bugs",
      "implication": "Separate retrieval diagnosis from dataset alignment",
      "justifies_architecture_change": false
    },
    {
      "id": 4,
      "finding": "Hierarchical retrieval failure",
      "proves": "Hierarchy added no unique gold vs flat",
      "implication": "Do not ship hierarchy as production candidate channel",
      "justifies_architecture_change": false,
      "anti_pattern": "hierarchy_as_default_channel"
    },
    {
      "id": 5,
      "finding": "HotpotQA BM25 baseline",
      "proves": "High Any-Hit, moderate All-Found (~0.581@10)",
      "implication": "Single-channel lexical incomplete for multi-evidence",
      "justifies_architecture_change": true,
      "scope": "experiment"
    },
    {
      "id": 6,
      "finding": "HotpotQA Dense complementarity",
      "proves": "Dense recovers golds BM25 misses and vice versa",
      "implication": "Union candidate generation justified",
      "justifies_architecture_change": true,
      "scope": "experiment"
    },
    {
      "id": 7,
      "finding": "HotpotQA union improvement",
      "proves": "All-Found ~0.766 as candidate-set upper bound at source depth 10",
      "implication": "Complementarity is real at CG layer; fair budget comparisons required",
      "justifies_architecture_change": true,
      "scope": "experiment"
    },
    {
      "id": 8,
      "finding": "HotpotQA CE coverage failures (920)",
      "proves": "Independent CE Top-K loses required complementary evidence already in pool",
      "implication": "Primary architecture gap is set-aware selection, not more retrieval",
      "justifies_architecture_change": true,
      "scope": "experiment_primary"
    },
    {
      "id": 9,
      "finding": "Bridge-heavy CE failures (93.7%)",
      "proves": "Bridge/multi-hop questions disproportionately suffer",
      "implication": "Set-aware selection should be evaluated with bridge breakdown",
      "justifies_architecture_change": true
    },
    {
      "id": 10,
      "finding": "Missing golds often ranks 11-15",
      "proves": "Near-miss under Top-10 budget; pool size ≤20",
      "implication": "Selection policy change can recover many failures without new retrieval",
      "justifies_architecture_change": true
    }
  ],
  "recommended_next_milestone": {
    "name": "set_aware_selection_over_frozen_hotpotqa_union_pool",
    "summary": "Replace independent CE Top-10 truncation with coverage-aware selection on the frozen BM25@10 ∪ Dense@10 pool; measure All-Found@10 vs BM25, Dense, raw union, and independent CE.",
    "addresses": "HotpotQA CE coverage failures (920) where pool is complete but Top-10 is not",
    "constraints": [
      "benchmark_only",
      "no_production_changes",
      "no_new_embedding_model",
      "no_LLM_required_for_v1",
      "no_new_retrieval_calls",
      "reuse_frozen_pools_and_ce_scores_where_possible"
    ],
    "success_metrics": [
