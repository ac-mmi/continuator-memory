# Copy to `.env` in this directory (never commit `.env`).
# The server and CLI load this file without overriding variables already
# set in the shell. Web answer generation requires a model name.

# Documented default used by the CLI and recommended for the UI.
CONTINUATOR_OLLAMA_MODEL=qwen2.5:1.5b

# Optional. Overrides CONTINUATOR_OLLAMA_MODEL for answer generation only.
# CONTINUATOR_ANSWER_MODEL=qwen2.5:1.5b

# Optional. Defaults to http://localhost:11434
# OLLAMA_HOST=http://localhost:11434

# Optional answer-generation settings.
# CONTINUATOR_ANSWER_ENABLED=1
# CONTINUATOR_ANSWER_TEMPERATURE=0
# CONTINUATOR_ANSWER_NUM_PREDICT=256
# CONTINUATOR_ANSWER_MAX_CHARS=12000

# Optional. Defaults to CONTINUATOR_ANSWER_MODEL or CONTINUATOR_OLLAMA_MODEL.
# CONTINUATOR_QUERY_PLAN_MODEL=qwen2.5:1.5b

# Experimental. Multi-query / iterative RRF weight for the original question
# (list 0). Unset keeps equal-weight RRF (1). Do not enable by default.
# CONTINUATOR_RRF_ORIGINAL_WEIGHT=4

# Experimental. LoCoMo report hybrid mode only: weight of the previous-turn
# context embedding (0..1). Unset keeps it off (0). Experiment value: 0.5.
# CONTINUATOR_CONTEXT_WEIGHT=0.5
